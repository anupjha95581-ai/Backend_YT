PORT=8000
CORS_ORIGIN=http://localhost:3000

# MongoDB
# Local example: mongodb://127.0.0.1:27017/VIDEOTUBE
# Atlas example: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>
MONGODB_URI=mongodb://127.0.0.1:27017/VIDEOTUBE

# JWT
ACCESS_TOKEN_SECRET=replace_with_a_long_random_access_token_secret
ACCESS_TOKEN_EXPIRATION=1d
REFRESH_TOKEN_SECRET=replace_with_a_long_random_refresh_token_secret
REFRESH_TOKEN_EXPIRATION=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
